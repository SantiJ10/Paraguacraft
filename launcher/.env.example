# Copiá este archivo a launcher/.env (nunca lo subas al repo).
# En builds de release, las keys se inyectan por CI con option_env! o variables de entorno.

GROQ_API_KEY=
# IMPORTANTE: la key de CurseForge empieza con $2a$10$…
# Usá comillas simples para que no se rompa el `$` (si no → 403 Forbidden en la tienda).
CURSEFORGE_API_KEY='$2a$10$pegá_tu_key_aquí'
OPENAI_API_KEY=
